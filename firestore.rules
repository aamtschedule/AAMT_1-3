rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if true;
      // Starter rule only: any signed-in user can write. Restrict to an admin
      // UID or custom claim before enabling sign-in for other users.
      allow write: if request.auth != null;
    }
  }
}
